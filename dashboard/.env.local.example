# Copy to .env.local and fill in. Never commit .env.local.

# Where the FastAPI backend runs.
API_URL=http://127.0.0.1:8000

# Must match DOCTOR_API_KEY in the backend. This stays on the server;
# the browser never sees it.
DOCTOR_API_KEY=change-me-same-as-backend

# Time zone used to show dates and times.
CLINIC_TZ=Asia/Karachi
