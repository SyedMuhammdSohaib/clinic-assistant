# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL 13 or newer (gen_random_uuid is built in).
DATABASE_URL=postgresql://clinic_user:change-me@localhost:5432/clinic

# Key the doctor dashboard sends in the X-Doctor-Key header. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DOCTOR_API_KEY=

# Key the chatbot service sends in the X-Bot-Key header (parent-facing actions only).
BOT_API_KEY=

# Used for "today" and for the pre-visit summary window.
CLINIC_TZ=Asia/Karachi

# Comma-separated origins allowed to call the API from a browser (your Next.js app).
CORS_ORIGINS=http://localhost:3000

# ---- Login codes by SMS (optional, free). Without these the code is printed in this terminal.
# Install "SMS Gateway for Android" (https://sms-gate.app) on the clinic's Android phone;
# the SMS goes from that phone's SIM. Cloud mode URL below; local mode is http://<phone IP>:8080/message
# SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1/message
# SMS_GATEWAY_USER=
# SMS_GATEWAY_PASSWORD=

# ---- AI (optional). Without a key the app uses simple keyword rules instead.
# Free key: https://aistudio.google.com/apikey
# Free tier note: Google may use what you send to improve its products. Use demo data only.
GEMINI_API_KEY=
# AI_PROVIDER=gemini            # or "offline" to switch AI off
# GEMINI_MODEL=gemini-3.8-flash # any free-tier Flash or Flash-Lite model
# GEMINI_EMBED_MODEL=gemini-embedding-001
# UPLOAD_DIR=uploads            # where prescription photos are stored
